# ============================================================
# Kenesis Loop Kit - .gitignore（パブリックリポジトリ用）
# tickets/ をコミット対象から除外する設定
# ============================================================

# チケット本体（作業ログ・内部情報）のみ除外。
# Templates/・_index.md はフレームワーク配布物として追跡する
tickets/active/*
tickets/done/*
!tickets/active/.gitkeep
!tickets/done/.gitkeep

# Obsidian の個人環境設定（ワークスペース・プラグイン設定など）
tickets/.obsidian/

# ループメトリクス（hookが自動生成。環境固有のためデフォルトでは追跡しない）
tickets/.metrics.jsonl
tickets/.metrics_state.json

# SPEC.mdドリフト検知用サイドカー（hookが自動生成。KLK-016）
docs/.spec_state.json

# Python生成ファイル（hook/metrics/testのコンパイル成果物）
__pycache__/
*.py[cod]

# OS生成ファイル
.DS_Store
Thumbs.db

# エディタ設定
.vscode/
.idea/

# Claude Code の個人ローカル設定（個人環境の許可設定を含むため共有しない）
.claude/settings.local.json

# 環境変数
.env
.env.local

# スキルのパッケージ成果物（ソースの正は .claude/skills/**/*.md。
# ZIP配布物はコミットしない — 二重管理による乖離を防ぐため）
*.skill

# docs/reports/{ID}/ 配下（サブエージェントレポートの詳細外部化。investigation/review等の
# 内部の意思決定記録のため、公開リポジトリでは追跡しない）。
# docs/reports/README.md（運用ルール定義。実体あるドキュメント）は docs/reports/ 直下の
# ファイルであり `docs/reports/*/` はサブディレクトリのみに一致するため対象外のまま追跡される
docs/reports/*/
